server {
	if ($host = kishibe.dyndns.tv) {
		return 301 https://$host$request_uri;
	} # managed by Certbot

	listen 80 default_server;
	listen [::]:80 default_server;

	server_name kishibe.dyndns.tv;

	location = /nginx_status {
		stub_status on;
		access_log off;
		# allow localhost;
		allow ::1;
		allow 127.0.0.1;
		allow 192.168.100.0/24;
		deny all;
	}

	location / {
		return 404;
	}
}

