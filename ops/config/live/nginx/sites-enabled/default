# ShogiBench stand-alone site
# Host: bench.kishibe.dyndns.tv
# ================================
server {
    server_name bench.kishibe.dyndns.tv;

    client_max_body_size 1g;

    # Application traffic for ShogiBench
    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/kishibe.dyndns.tv/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/kishibe.dyndns.tv/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = bench.kishibe.dyndns.tv) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name bench.kishibe.dyndns.tv;
    return 404; # managed by Certbot


}
