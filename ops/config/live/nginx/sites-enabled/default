# Default server configuration
#
server {

	# SSL configuration
	#
	# listen 443 ssl default_server;
	# listen [::]:443 ssl default_server;
	#
	# Note: You should disable gzip for SSL traffic.
	# See: https://bugs.debian.org/773332
	#
	# Read up on ssl_ciphers to ensure a secure configuration.
	# See: https://bugs.debian.org/765782
	#
	# Self signed certs generated by the ssl-cert package
	# Don't use them in a production server!
	#
	# include snippets/snakeoil.conf;

	root /var/www/html;

	# Add index.php to the list if you are using PHP
	index index.html index.htm index.nginx-debian.html;

	server_name kishibe.dyndns.tv;


	location = /qmaclone {
		return 301 /qmaclone/;
	}

	location /qmaclone/ {
		# Delegate to apache (landing site)
		proxy_pass http://127.0.0.1:48080;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header X-Forwarded-Port 443;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-Server $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}


	location / {
		# Delegate to apache.
		proxy_pass http://localhost:48080;
		# proxy_redirect off;
		# https://qiita.com/katsura_tarou_a/items/a8e076116cf45d9c306b
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header X-Forwarded-Port 443;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-Server $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		client_max_body_size 16m;

		deny 202.15.16.0/20; # Aichi Institute of Technology
		deny 14.132.96.0/19; # Chubu Telecommunications Co.,Inc.
		allow all;
	}


	location = /QMAClone {
		return 301 /QMAClone/;
	}

	location /QMAClone/ {
		# Public canonical path for QMAClone
		proxy_pass http://localhost:8080/QMAClone/;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header X-Forwarded-Port 443;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-Server $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_cookie_path /QMAClone/ /QMAClone/;
		proxy_set_header X-Forwarded-Prefix /QMAClone;
		client_max_body_size 16m;
		add_header Cache-Control "no-cache, no-store, must-revalidate" always;
		add_header Pragma "no-cache" always;
		add_header Expires "0" always;
	}

	location /QMAClone/websocket {
		proxy_pass http://localhost:8080/QMAClone/websocket;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
	}

	location /QMAClone-1.0-SNAPSHOT {
		return 301 /QMAClone/;
	}




	location /nginx_status {
		stub_status on;
		access_log off;
		# allow localhost;
		allow ::1;
		allow 127.0.0.1;
		allow 192.168.100.0/24;
		deny all;
	}

	location /QueenPuzzle-1.0-SNAPSHOT {
		return 404;
	}


	location /TouchTheNumbers-1.0-SNAPSHOT {
		return 404;
	}


	location /zetsubou {
		return 404;
	}


	location /SoundPlayer-1.0-SNAPSHOT {
		return 404;
	}


	location /FourthMission {
		return 404;
	}


	location /DirectorRoom {
		return 404;
	}


	location /LaboratoryC {
		return 404;
	}


	location /rss {
		proxy_pass http://127.0.0.1:8000;
	}

	listen [::]:443 ssl ipv6only=on; # managed by Certbot
	listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/kishibe.dyndns.tv/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/kishibe.dyndns.tv/privkey.pem; # managed by Certbot
	include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}


